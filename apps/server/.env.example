# Copy to apps/server/.env for local development. Never commit .env.
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/discord_stream
# From the Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=
# Right-click the channel in Discord (Developer Mode on) → Copy Channel ID
DISCORD_CHANNEL_ID=
# Integration tests use a separate Postgres schema so they never touch dev data. Unset = repo tests skipped.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/discord_stream?schema=test
